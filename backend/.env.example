# Server Configuration
PORT=5000
NODE_ENV=development
DEMO_MODE=true
ENABLE_ENDPOINT_AGENT=false

# Security & Authentication Secrets (Required! Minimum 32 characters in production)
JWT_SECRET=cyberguard_prototype_jwt_secret_key_change_in_production_min32chars
COMMAND_SIGNING_SECRET=cyberguard_prototype_command_hmac_secret_min32chars

# Allowed CORS Origin(s) - comma separated or specific domain for production
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables (Vite client configuration)
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# Optional: CyberGuard Grid MySQL Database Configuration (Fallback to SQLite if omitted)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyberguard_grid
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
