# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origin(s) - comma separated or specific domain for production
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: CyberGuard Grid MySQL Database Configuration (Fallback to SQLite if omitted)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyberguard_grid
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
